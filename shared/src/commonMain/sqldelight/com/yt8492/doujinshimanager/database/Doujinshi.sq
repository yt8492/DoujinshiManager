CREATE TABLE doujinshis (
  id TEXT PRIMARY KEY NOT NULL,
  title TEXT NOT NULL,
  circle_id TEXT,
  event_id TEXT,
  pub_date TEXT,
  created_at TEXT NOT NULL,
  FOREIGN KEY (circle_id) REFERENCES circles(id),
  FOREIGN KEY (event_id) REFERENCES events(id)
);

CREATE TABLE doujinshis_authors (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  doujinshi_id TEXT NOT NULL,
  author_id TEXT NOT NULL,
  FOREIGN KEY (doujinshi_id) REFERENCES doujinshis(id),
  FOREIGN KEY (author_id) REFERENCES authors(id)
);

CREATE TABLE doujinshis_tags (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  doujinshi_id TEXT NOT NULL,
  tag_id TEXT NOT NULL,
  FOREIGN KEY (doujinshi_id) REFERENCES doujinshis(id),
  FOREIGN KEY (tag_id) REFERENCES tags(id)
);

CREATE TABLE doujinshis_images (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  doujinshi_id TEXT NOT NULL,
  image_path TEXT NOT NULL,
  FOREIGN KEY (doujinshi_id) REFERENCES doujinshis(id)
);

CREATE INDEX doujinshi_title ON doujinshis(title);

find:
SELECT doujinshis.*, circles.id AS circleId, circles.name AS circleName,
       events.id AS eventId, events.name AS eventName, events.start_at, events.end_at
FROM doujinshis
LEFT OUTER JOIN circles ON doujinshis.circle_id = circles.id
LEFT OUTER JOIN events ON doujinshis.event_id = events.id
WHERE (:keywordQuery ISNULL OR doujinshis.title LIKE :keywordQuery)
AND (:circleId ISNULL OR doujinshis.circle_id = :circleId)
AND (:eventId ISNULL OR doujinshis.event_id = :eventId)
AND (:authorsIsEmpty OR doujinshis.id IN (
  SELECT doujinshi_id FROM doujinshis_authors WHERE author_id IN :authorIds
))
AND (:tagsIsEmpty OR doujinshis.id IN (
  SELECT doujinshi_id FROM doujinshis_tags WHERE tag_id IN :tagIds
  GROUP BY doujinshi_id HAVING COUNT(DISTINCT tag_id) = :tagsCount
))
AND (:startDate ISNULL OR :startDate <= doujinshis.pub_date)
AND (:endDate ISNULL OR doujinshis.pub_date <= :endDate)
ORDER BY doujinshis.created_at DESC, doujinshis.id DESC
LIMIT :limit OFFSET :offset;

findAuthorsForBooks:
SELECT da.doujinshi_id, authors.id AS author_id, authors.name AS author_name
FROM doujinshis_authors da JOIN authors ON da.author_id = authors.id
WHERE da.doujinshi_id IN :bookIds
ORDER BY da.id;

findTagsForBooks:
SELECT dt.doujinshi_id, tags.id AS tag_id, tags.name AS tag_name
FROM doujinshis_tags dt JOIN tags ON dt.tag_id = tags.id
WHERE dt.doujinshi_id IN :bookIds
ORDER BY dt.id;

findImagesForBooks:
SELECT doujinshi_id, image_path FROM doujinshis_images
WHERE doujinshi_id IN :bookIds
ORDER BY id;

findById:
SELECT *
FROM doujinshis
LEFT OUTER JOIN circles ON doujinshis.circle_id = circles.id
LEFT OUTER JOIN events ON doujinshis.event_id = events.id
LEFT OUTER JOIN doujinshis_authors da ON doujinshis.id = da.doujinshi_id
LEFT OUTER JOIN authors ON da.author_id = authors.id
LEFT OUTER JOIN doujinshis_tags dt ON doujinshis.id = dt.doujinshi_id
LEFT OUTER JOIN tags ON dt.tag_id = tags.id
LEFT OUTER JOIN doujinshis_images di ON doujinshis.id = di.doujinshi_id
WHERE doujinshis.id = ?
ORDER BY di.id ASC, da.id ASC, dt.id ASC;

findDoujinshiImages:
SELECT *
FROM doujinshis_images
LIMIT :limit
OFFSET :offset;

insertDoujinshi:
INSERT INTO doujinshis (id, title, circle_id, event_id, pub_date, created_at)
VALUES (?, ?, ?, ?, ?, ?);

insertDoujinshisAuthors:
INSERT INTO doujinshis_authors (doujinshi_id, author_id)
VALUES (?, ?);

insertDoujinshisTags:
INSERT INTO doujinshis_tags (doujinshi_id, tag_id)
VALUES (?, ?);

insertDoujinshiImages:
INSERT INTO doujinshis_images (doujinshi_id, image_path)
VALUES (?, ?);

updateDoujinshi:
UPDATE doujinshis SET title = ?, circle_id = ?, event_id = ?, pub_date = ?
WHERE id = ?;

updateDoujinshiImage:
UPDATE doujinshis_images SET image_path = ?
WHERE id = ?;

removeDoujinshisAuthors:
DELETE FROM doujinshis_authors WHERE doujinshi_id = ? AND author_id = ?;

removeDoujinshisTags:
DELETE FROM doujinshis_tags WHERE doujinshi_id = ? AND tag_id = ?;

removeDoujinshiImages:
DELETE FROM doujinshis_images WHERE doujinshi_id = ? AND image_path = ?;

deleteDoujinshiAuthorsByDoujinshiId:
DELETE FROM doujinshis_authors WHERE doujinshi_id = ?;

deleteDoujinshiTagsByDoujinshiId:
DELETE FROM doujinshis_tags WHERE doujinshi_id = ?;

deleteDoujinshiImagesByDoujinshiId:
DELETE FROM doujinshis_images WHERE doujinshi_id = ?;

deleteDoujinshiById:
DELETE FROM doujinshis WHERE id = ?;

deleteAllDoujinshis:
DELETE FROM doujinshis;

deleteAllDoujinshiAuthors:
DELETE FROM doujinshis_authors;

deleteAllDoujinshiTags:
DELETE FROM doujinshis_tags;

deleteAllDoujinshiImages:
DELETE FROM doujinshis_images;
